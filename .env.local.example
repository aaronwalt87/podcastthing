# ── Storage ──────────────────────────────────────────────────────────────────
# Upstash Redis — auto-added when you install it from the Vercel Marketplace.
# Without these the site still renders; it just has nothing cached to show.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob — auto-added when you connect a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Shared admin password, compared via HMAC. There is no user database.
ADMIN_PASSWORD=

# ── Scheduled refresh ────────────────────────────────────────────────────────
# Bearer token required by /api/news/refresh and /api/stocks/refresh.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Signing key for admin session cookies. Strongly recommended: without it the
# admin password is stretched through PBKDF2 and used as key material instead,
# which works but ties cookie security to password strength.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Market data (optional) ───────────────────────────────────────────────────
# Finnhub free-tier key for intraday quotes. Without it the market board falls
# back to Stooq end-of-day closes, which need no key.
FINNHUB_TOKEN=

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin. Feeds the canonical tags and the social card; the built-in
# default is a guess, so set this before sharing any link.
NEXT_PUBLIC_SITE_URL=

# ── Tuning (optional) ────────────────────────────────────────────────────────
# News cache TTL in seconds. Default 7200 (2h). Use 90000 on a daily cron.
# NEWS_TTL_SECONDS=7200
